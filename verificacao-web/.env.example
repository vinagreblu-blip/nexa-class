# ============================================================
# CONFIGURAÇÃO DO SERVIÇO WEB NEXA CLASS (verificacao-web)
# Deploy para QR codes públicos — válido em qualquer rede/celular.
# ============================================================

# Porta interna do serviço (Render/Railway ignora, usam a porta que atribuem).
PORT=3001

# API key forte — DEVE ser idêntica em:
#  1. Aqui (serviço web público)
#  2. Em CADA máquina desktop via env VERIFICACAO_API_KEY
#
# Gerar com (32 bytes hex):
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Em NODE_ENV=production, este default público é RECUSADO — use uma forte.
API_KEY=GERAR-KEY-FORTE-COMANDO-ACIMA

# URL pública completa do serviço (HTTPS obrigatório).
# Exemplos:
#   RENDER:    https://nexa-verificacao.onrender.com
#   RAILWAY:   https://nexa-verificacao.up.railway.app
#   VPS:       https://verificacao.suaescola.edu.br
#
# Esta URL entra no QR Code → deve ser acessível pela internet.
# Setar igual no desktop via env VERIFICACAO_BASE_URL.
PUBLIC_URL=https://nexa-verificacao.onrender.com

# Nome da instituição exibido na página pública /v/:codigo.
INSTITUICAO=NEXA CLASS - Network for Education and Academic Excellence Class

# Modo: 'production' recusa API key default/vazia/curta.
NODE_ENV=production

# Sentry (opcional): captura automática de erros.
# Gere em https://sentry.io ou self-hosted GlitchTip.
# SENTRY_DSN=https://<key>@<host>/<id>

# Hardening ativo por padrão:
#  - helmet: headers HTTP seguros (CSP, X-Content-Type-Options, etc.)
#  - rate-limit: 100 req/min por IP, mensagem JSON consistente
#  - bcrypt no compareSync da API key (timing-safe)
#  - redact de PII em logs (LGPD: e-mail/cpf/senha nunca aparecem)
