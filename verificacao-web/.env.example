# Porta do servico
PORT=3001

# API key que o app desktop envia no header x-api-key
# Deve bater com VERIFICACAO_API_KEY do desktop.
# O valor abaixo é apenas para desenvolvimento — em produção (NODE_ENV=production)
# o serviço recusa iniciar com este default. Gere uma key forte com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_KEY=nexa-dev-api-key-trocar

# Caminho do banco SQLite
DB_PATH=./data/verificacao.sqlite

# Nome da instituicao exibido na pagina publica
INSTITUICAO=NEXA CLASS - Network for Education and Academic Excellence Class

# Define o modo: em "production" a API key default é recusada.
NODE_ENV=development

# Hardening ativo por padrão (helmet + rate-limit de 100 req/min por IP):
#  - helmet: headers HTTP seguros (CSP, X-Content-Type-Options, etc.)
#  - rate-limit: protege contra enumeração de códigos e DoS básico
# Limites podem ser ajustados em server/app.ts (RATE_LIMIT_DEFAULT_MAX/JANELA_MS).

# Sentry (opcional): se setada, erros são reportados automaticamente.
# Compatível com Sentry cloud ou GlitchTip self-hosted.
# Gere uma DSN em https://sentry.io/ ou no seu GlitchTip.
# SENTRY_DSN=https://<key>@<host>/<id>

# LGPD: sendDefaultPii=false (configurado no código) — IPs e headers não são enviados.
